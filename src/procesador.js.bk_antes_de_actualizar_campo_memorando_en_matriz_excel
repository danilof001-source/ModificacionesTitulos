const MAPA_PAISES = require('../public/paises'); // Asegúrate de que la ruta sea correcta según tu proyecto

function obtenerIdPaisPorNombre(nombrePais) {
    if (!nombrePais) return 'NULL';
    const nombreNormalizado = String(nombrePais).trim().toUpperCase();
    for (const [id, nombre] of Object.entries(MAPA_PAISES)) {
        if (String(nombre).toUpperCase() === nombreNormalizado) {
            return id;
        }
    }
    return 'NULL'; // Si no encuentra el país, envía NULL para que SQL no explote
}

