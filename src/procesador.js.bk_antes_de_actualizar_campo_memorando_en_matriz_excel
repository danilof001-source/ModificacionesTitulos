async function procesarArchivoExcel(filePath) {
    const workbook = new ExcelJS.Workbook();
    await workbook.xlsx.readFile(filePath);
    const worksheet = workbook.getWorksheet(1);
    
    // --- VALIDACIÓN ESTRUCTURA ---
    const headersRow = worksheet.getRow(1).values;
    const headersArchivo = headersRow.map(h => h ? h.toString().trim() : '').filter(h => h !== '');
    
    const faltantes = ESTRUCTURA_ESPERADA.filter(colEsperada => 
        !headersArchivo.some(h => h.toUpperCase() === colEsperada.toUpperCase())
    );

    if (faltantes.length > 0) {
        throw new Error(`La estructura del archivo es incorrecta. Faltan las columnas: ${faltantes.join(', ')}`);
    }

    // --- MAPEO DE COLUMNAS ---
    const getCol = (name) => headersRow.findIndex(h => h && h.toString().trim().toUpperCase() === name.toUpperCase());

    const map = {
        no: getCol("No"),
        tipo: getCol("TIPO_MODIFICACION"),
        memorando: getCol("MEMORANDO"),
        cedula: getCol("CEDULA_O_PASAPORTE_SEGUN_REGISTRO"),
        tipo_identificacion: getCol("TIPO_IDENTIFICACION"),
        nombres: getCol("NOMBRES"),
        registro: getCol("NUMERO_REGISTRO"),
        fecha: getCol("FECHA_REGISTRO"),
        genero: getCol("GENERO"),
        nacionalidad: getCol("NACIONALIDAD"),
        observacion: getCol("OBSERVACION"),
        nivel: getCol("NIVEL_FORMACION"),
        titulo: getCol("TITULO_REGISTRADO_SNIESE"),
        ies: getCol("NOMBRE_IES"),
        codigo_ies: getCol("IES_QUE_SOLICITA_CAMBIO"), //codigo iess original (informacion opcional)
        conocimiento: getCol("AREA_O_CAMPO_CONOCIMIENTO"),

        // Campos de la matriz espejo
        m_cedula: getCol("M_CEDULA_O_PASAPORTE_SEGUN_REGISTRO"),
        m_tipo_identificacion: getCol("M_TIPO_IDENTIFICACION"),
        m_nombres: getCol("M_NOMBRES"),
        m_registro: getCol("M_NUMERO_REGISTRO"),
        m_fecha: getCol("M_FECHA_REGISTRO"),
        m_genero: getCol("M_GENERO"),
        m_nacionalidad: getCol("M_NACIONALIDAD"),
        m_observacion: getCol("M_OBSERVACION"),
        m_nivel: getCol("M_NIVEL_FORMACION"),
        m_titulo: getCol("M_TITULO_REGISTRADO_SNIESE"),
        m_ies: getCol("M_NOMBRE_IES"),
        m_codigo_ies: getCol("M_IES_QUE_SOLICITA_CAMBIO"), //nuevo codigo ies proporcionado por la DRT
        m_conocimiento: getCol("M_AREA_O_CAMPO_CONOCIMIENTO"),

        // Extras
        tipo_titulacion: getCol("INFO_ADICIONAL1"),
        info_adicional: getCol("INFO_ADICIONAL2")      
    };

    if (map.tipo === -1) throw new Error("No se encontró la columna TIPO_MODIFICACION");

    const datosExcel = [];
    // ELIMINADO: Arrays de IDs masivos (idsParaConsultaPre, idsParaConsultaPost)
    const erroresValidacion = [];
    
    let memorandoGlobal = "";
    let contadorSecuencialEsperado = 1;

    // --- MAPA PARA TRADUCIR NÚMEROS ANTIGUOS A CÓDIGOS NUEVOS ---
    const MAPA_LEGACY = {
        '1': 'IOBS', '2': 'MOBS', '3': 'AOBS', '4': 'EOBS', '5': 'CNOM',
        '6': 'CTIT', '7': 'CIES', '8': 'CNIV', '9': 'CIDE', '10': 'CGEN',
        '11': 'CCON', '12': 'CNAC'
    };

    // --- ITERACIÓN Y VALIDACIÓN ---
    worksheet.eachRow((row, rowNumber) => {
        if (rowNumber === 1) return; 
        
        // --- FUNCIÓN DE LECTURA VISUAL (Prioriza .text) ---
        const getData = (idx) => {
            if (idx === -1) return "";
            const cell = row.getCell(idx);
            
            // 1. Prioridad: Texto Visual (.text)
            let val = cell.text;
            
            // 2. Fallback: Valor Crudo (.value)
            if (!val && cell.value !== null && cell.value !== undefined) {
                 if (typeof cell.value === 'object') {
                    val = cell.value.text || cell.value.result || "";
                 } else {
                    val = cell.value.toString();
                 }
            }
            return val ? val.toString().trim() : "";
        };
        
        const noValRaw = row.getCell(map.no).value;
        const noVal = parseInt(noValRaw);
        
        let tipoModRaw = row.getCell(map.tipo).value;
        if (typeof tipoModRaw === 'object' && tipoModRaw !== null) {
            tipoModRaw = tipoModRaw.text || tipoModRaw.result;
        }
        
        let tipoMod = tipoModRaw ? tipoModRaw.toString().trim().toUpperCase() : "";

        if (MAPA_LEGACY[tipoMod]) {
            tipoMod = MAPA_LEGACY[tipoMod];
        }

        const identificadorFila = !isNaN(noVal) ? `Registro No ${noVal}` : `Fila Excel ${rowNumber}`;

        if (isNaN(noVal)) {
            erroresValidacion.push(`${identificadorFila}: El campo "No" está vacío o no es un número.`);
        } else if (noVal !== contadorSecuencialEsperado) {
            erroresValidacion.push(`${identificadorFila}: Error de secuencia. Se esperaba ${contadorSecuencialEsperado}, se encontró ${noVal}.`);
        }
        contadorSecuencialEsperado++;

        // VALIDAR SI EL CÓDIGO EXISTE EN LAS REGLAS
        if (!tipoMod || !REGLAS_VALIDACION[tipoMod]) {
            erroresValidacion.push(`${identificadorFila}: TIPO_MODIFICACION '${tipoModRaw}' no es un código válido.`);
        } else {
            const camposRequeridos = REGLAS_VALIDACION[tipoMod];
            const faltantesFila = [];
            camposRequeridos.forEach(colName => {
                const idx = getCol(colName);
                const val = getData(idx);
                if (!val || val === '') faltantesFila.push(colName);
            });

            if (faltantesFila.length > 0) {
                erroresValidacion.push(`${identificadorFila} (Tipo ${tipoMod}): Faltan datos en [${faltantesFila.join(', ')}]`);
            }

            // LÓGICA ESPECÍFICA PARA CIDE
            if (tipoMod === 'CIDE') {
                let vTipo = getData(map.tipo_identificacion).toUpperCase();
                let vCedula = getData(map.cedula); // Columna existente
                let vMTipo = getData(map.m_tipo_identificacion).toUpperCase();
                let vMCedula = getData(map.m_cedula);

                if (vTipo !== 'P' && vTipo !== 'C') {
                    erroresValidacion.push(`${identificadorFila}: TIPO_IDENTIFICACION debe ser 'P' o 'C' (Encontrado: '${vTipo}').`);
                }
                if (vMTipo !== 'P' && vMTipo !== 'C') {
                    erroresValidacion.push(`${identificadorFila}: M_TIPO_IDENTIFICACION debe ser 'P' o 'C' (Encontrado: '${vMTipo}').`);
                }
                if (vTipo === 'C') {
                    if (!/^\d{10}$/.test(vCedula)) {
                        erroresValidacion.push(`${identificadorFila}: TIPO_IDENTIFICACION es 'C' (Cédula) y se requiere 10 dígitos en CEDULA_O_PASAPORTE_SEGUN_REGISTRO. Valor leído: '${vCedula}'.`);
                    }
                }
                if (vMTipo === 'C') {
                    if (!/^\d{10}$/.test(vMCedula)) {
                        erroresValidacion.push(`${identificadorFila}: M_TIPO_IDENTIFICACION es 'C' (Cédula) y se requiere 10 dígitos en M_CEDULA_O_PASAPORTE_SEGUN_REGISTRO. Valor leído: '${vMCedula}'.`);
                    }
                }
            }
        }


            // --- VALIDACIÓN CGEN: ESTRICTAMENTE 'M' o 'F' ---
            if (tipoMod === 'CGEN') {
                const generoRaw = getData(map.m_genero);
                // Convertimos a string, quitamos espacios y hacemos mayúscula
                const generoCheck = generoRaw ? generoRaw.toString().trim().toUpperCase() : '';

                // Regla: Si no es 'M' y no es 'F', es un error.
                if (generoCheck !== 'M' && generoCheck !== 'F') {
                    erroresValidacion.push(`${identificadorFila}: El campo M_GENERO debe ser estrictamente 'M' o 'F'. Valor encontrado: '${generoRaw}'`);
                }
            }
            // ------------------------------------------------


        if (erroresValidacion.length > 0) return; 

        // Normalización de P/C a PASAPORTE/CEDULA
        let finalTipoIdentificacion = getData(map.tipo_identificacion);
        let finalMTipoIdentificacion = getData(map.m_tipo_identificacion);

        if (tipoMod === 'CIDE') {
            finalTipoIdentificacion = (finalTipoIdentificacion.toUpperCase() === 'P') ? 'PASAPORTE' : 'CEDULA';
            finalMTipoIdentificacion = (finalMTipoIdentificacion.toUpperCase() === 'P') ? 'PASAPORTE' : 'CEDULA';
        }

        // --- CÁLCULO DE ID DE BÚSQUEDA INDIVIDUAL ---
        // Esto servirá para que el servidor sepa qué buscar sin recalcular lógica
        let idBusqueda = "";
        if (tipoMod === 'CIDE') {
            // Para CIDE, la búsqueda es por la cédula original
            idBusqueda = getData(map.cedula);
        } else {
             // Para el resto: Eliminación total de espacios en cédula y registro
             const cedulaLimpia = getData(map.cedula).replace(/\s+/g, '');
             const registroLimpio = getData(map.registro).replace(/\s+/g, '');
             idBusqueda = cedulaLimpia + registroLimpio;
        }

        const item = {
            no: row.getCell(map.no).value,
            tipoModificacion: tipoMod,
            memorando: getData(map.memorando),
            cedula: getData(map.cedula),
            tipo_identificacion: finalTipoIdentificacion,
            nombres: getData(map.nombres),
            registro: getData(map.registro),
            fecha: getData(map.fecha),
            genero: getData(map.genero),
            nacionalidad: getData(map.nacionalidad),
            observacion: getData(map.observacion),
            nivel: getData(map.nivel),
            titulo: getData(map.titulo),
            ies: getData(map.ies),
            codigo_ies: getData(map.codigo_ies),
            conocimiento: getData(map.conocimiento),
            
            // Nuevas propiedades
            m_cedula: getData(map.m_cedula),          
            m_tipo_identificacion: finalMTipoIdentificacion,
            m_nombres: getData(map.m_nombres),
            m_fecha: getData(map.m_fecha),
            m_genero: getData(map.m_genero),
            m_nacionalidad: getData(map.m_nacionalidad),
            m_observacion: getData(map.m_observacion),
            m_nivel: getData(map.m_nivel),
            m_titulo: getData(map.m_titulo),
            m_ies: getData(map.m_ies),
            m_codigo_ies: getData(map.m_codigo_ies),
            m_conocimiento: getData(map.m_conocimiento),

            // AGREGADO: Propiedad pre-calculada para búsqueda individual
            idBusqueda: idBusqueda
        };

        if (!memorandoGlobal && item.memorando) memorandoGlobal = item.memorando;
        datosExcel.push(item);
        
        // ELIMINADO: Bloque que empujaba IDs a arrays masivos (idsParaConsultaPre.push...)

    });

    if (erroresValidacion.length > 0) {
        const error = new Error("La matriz de datos contiene errores de contenido.");
        error.validationErrors = erroresValidacion; 
        throw error;
    }

    if (datosExcel.length === 0) {
        throw new Error("No se encontraron registros válidos para procesar.");
    }

    // ELIMINADO: Bloque de generación de script masivo (if (esTipoCIDE) ... else ...)

    // RETORNO LIMPIO: Solo los datos, el servidor se encargará de iterar y consultar.
    return { datosExcel, memorando: memorandoGlobal };
}



// ===============================================================================
// GENERADOR DE SCRIPTS DE CONSULTA (PRE vs POST) - BASADO EN EXCEL
// ===============================================================================
const generarSQLAgrupado = (datosExcel) => {
    const scripts = diccionario.scripts;
    
    const construirBloque = (modo) => {
        const gruposGenericos = {};
        const grupos = {
            'CCON': [], 'CNOM': [], 'CNAC': [], 'CIDE': [], 'CGEN': []
        };
        const cedulasVistasCIDE = new Set();

        const sqlStr = (txt) => {
            if (txt === null || txt === undefined || txt === '') return "''";
            return "'" + String(txt).replace(/'/g, "''").trim() + "'";
        };

        // ITERAMOS DIRECTAMENTE SOBRE LA MATRIZ ORIGINAL
        datosExcel.forEach(d => {
            const item = d.no;
            const tipoMod = d.tipoModificacion;

            // EXTRACCIÓN Y SANITIZACIÓN ---
            let cedulaBusqueda;

            // Si es CIDE y estamos armando el script POST, buscamos por la cédula nueva
            if (tipoMod === 'CIDE' && modo === 'POST') {
                cedulaBusqueda = d.m_cedula;
            } else {
                // En cualquier otro caso (PRE, o tipos que no cambian ID), usamos la original
                cedulaBusqueda = d.cedula;
            }

            // Sanitizamos los valores principales
            const cedulaSQL = sqlStr(cedulaBusqueda);
            const registroSQL = sqlStr(d.registro);

            // CLASIFICACIÓN EN GRUPOS ---
            if (tipoMod === 'CIDE') {
                const cedulaKey = String(cedulaBusqueda || '').trim();
                // Evitamos duplicar consultas de la misma cédula
                if (cedulaKey && !cedulasVistasCIDE.has(cedulaKey)) {
                    cedulasVistasCIDE.add(cedulaKey);
                    grupos['CIDE'].push(`(${cedulaSQL}, ${item})`);
                }
            } 
            else if (tipoMod === 'CCON') {
                grupos['CCON'].push(`(${cedulaSQL}, ${registroSQL}, ${item})`);
            } 
            else if (tipoMod === 'CNOM') {
                const nombreVal = modo === 'PRE' ? d.nombres : (d.m_nombres || d.nombres);
                grupos['CNOM'].push(`(${cedulaSQL}, ${sqlStr(nombreVal)}, ${item})`);
            } 
            else if (tipoMod === 'CNAC') {
                const nacVal = modo === 'PRE' ? d.nacionalidad : (d.m_nacionalidad || d.nacionalidad);
                // Traducimos el texto (ej. "ECUADOR") al ID numérico (ej. 74)
                const idPais = obtenerIdPaisPorNombre(nacVal); 
                // Inyectamos idPais sin comillas simples porque es un número (o la palabra reservada NULL)
                grupos['CNAC'].push(`(${cedulaSQL}, ${idPais}, ${item})`);
            } 
            else if (tipoMod === 'CGEN') {
                let valorFinal;
                if (modo === 'PRE') {
                    valorFinal = d.genero;
                } else {
                    let raw = (d.m_genero || d.genero || '').toString().trim().toUpperCase();
                    valorFinal = (raw === 'M') ? 'MASCULINO' : (raw === 'F') ? 'FEMENINO' : raw;
                }
                grupos['CGEN'].push(`(${cedulaSQL}, ${sqlStr(valorFinal)}, ${item})`);
            } 
            else {
                // TIPOS GENÉRICOS (MOBS, EOBS, CTIT, etc.)
                if (!gruposGenericos[tipoMod]) {
                    gruposGenericos[tipoMod] = [];
                }
                gruposGenericos[tipoMod].push(`(${cedulaSQL}, ${registroSQL}, ${item})`);
            }
        }); // <-- AQUÍ TERMINA EL forEach DE datosExcel

        // --- PASO 4: CONSTRUCCIÓN DEL SCRIPT SQL ---
        //let sql = `\n-- === CONSULTA DE VERIFICACIÓN ${modo} (Input: Excel) ===\n`;
        let sql = ''
        
        // Calculamos el total de registros agrupados
        const totalFijos = Object.values(grupos).reduce((acc, arr) => acc + arr.length, 0);
        const totalGenericos = Object.values(gruposGenericos).reduce((acc, arr) => acc + arr.length, 0);
        
        if ((totalFijos + totalGenericos) === 0) return sql + "-- No hay datos procesados.\n";

        // Función helper para inyectar
        const inyectar = (lista, scriptTemplate) => {
            const valores = lista.join(',\n        ');
            return scriptTemplate
                .replace('<valores>', valores)
                .replace('<<REEMPLAZAR_VALORES>>', valores) + ";\n";
        };

        // Inyectamos los grupos especiales
        if (grupos['CCON'].length > 0) {
            sql += `\n-- TIPO CCON: ${grupos['CCON'].length} regs\n`;
            sql += inyectar(grupos['CCON'], scripts.consultaPrePostModificacionCCON);
        }
        if (grupos['CNOM'].length > 0) {
            sql += `\n-- TIPO CNOM: ${grupos['CNOM'].length} regs\n`;
            sql += inyectar(grupos['CNOM'], scripts.consultaPrePostModificacionCNOM);
        }
        if (grupos['CNAC'].length > 0) {
            sql += `\n-- TIPO CNAC: ${grupos['CNAC'].length} regs\n`;
            sql += inyectar(grupos['CNAC'], scripts.consultaPrePostModificacionCNAC);
        }
        if (grupos['CGEN'].length > 0) {
            sql += `\n-- TIPO CGEN: ${grupos['CGEN'].length} regs\n`;
            sql += inyectar(grupos['CGEN'], scripts.consultaPrePostModificacionCGEN);
        }    
        if (grupos['CIDE'].length > 0) {
            sql += `\n-- TIPO CIDE: ${grupos['CIDE'].length} regs\n`;
            sql += inyectar(grupos['CIDE'], scripts.consultaPreModificacionIdentificacion);
        }

        // Inyectamos los grupos genéricos (EOBS, MOBS, CTIT, etc.)
        Object.keys(gruposGenericos).forEach(tipo => {
            const lista = gruposGenericos[tipo];
            if (lista.length > 0) {
                sql += `\n-- TIPO ${tipo}: ${lista.length} regs\n`;
                sql += inyectar(lista, scripts.consultaPrePostModificacion);
            }
        });

        return sql;
    }; // <-- AQUÍ TERMINA construirBloque

    // RETORNO DE LA FUNCIÓN PRINCIPAL
    return {
        sqlAgrupadoPre: construirBloque('PRE'),
        sqlAgrupadoPost: construirBloque('POST')
    };
}; // <-- AQUÍ TERMINA generarSQLAgrupado



// NUEVA FUNCIÓN: Genera JSON de conteo por tipo exitoso para Logs de Postgres
const generarEstadisticasJSON = (resultados) => {
    const contadores = {};

    resultados.forEach(res => {
        // Solo contamos los que fueron procesados exitosamente
        if (res.exito) {
            const tipo = res.tipo || 'DESCONOCIDO';
            contadores[tipo] = (contadores[tipo] || 0) + 1;
        }
    });

    // Retorna string JSON listo para insertar (ej: '{"MOBS": 7, "CNAC": 5}')
    return JSON.stringify(contadores);
};


module.exports = { 
    procesarArchivoExcel,
    generarSQLAgrupado,
    generarEstadisticasJSON 
};